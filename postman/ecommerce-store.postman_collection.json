{
  "info": {
    "name": "MERN E-Commerce Store API",
    "description": "API collection for the MERN E-Commerce Store. Start the backend on http://localhost:5000, then run Register or Login first. Postman cookies must be enabled for JWT authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "userId", "value": "replace-user-id" },
    { "key": "productId", "value": "replace-product-id" },
    { "key": "categoryId", "value": "replace-category-id" },
    { "key": "orderId", "value": "replace-order-id" }
  ],
  "item": [
    {
      "name": "Users and Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123!\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123!\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users/auth"
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/users/logout" }
        },
        {
          "name": "Get My Profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/profile" }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"Updated User\",\n  \"email\": \"updated@example.com\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users/profile"
          }
        },
        {
          "name": "Admin - List Users",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users" }
        },
        {
          "name": "Admin - Get User",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}" }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        { "name": "List Products", "request": { "method": "GET", "url": "{{baseUrl}}/api/products" } },
        { "name": "List All Products", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/allproducts" } },
        { "name": "Top Products", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/top" } },
        { "name": "New Products", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/new" } },
        {
          "name": "Get Product",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productId}}" }
        },
        {
          "name": "Filter Products",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"checked\": [],\n  \"radio\": []\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/filtered-products"
          }
        },
        {
          "name": "Add Product Review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Great product\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/{{productId}}/reviews"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        { "name": "List Categories", "request": { "method": "GET", "url": "{{baseUrl}}/api/category/categories" } },
        { "name": "Get Category", "request": { "method": "GET", "url": "{{baseUrl}}/api/category/{{categoryId}}" } },
        {
          "name": "Admin - Create Category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Electronics\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/category"
          }
        },
        { "name": "Admin - Update Category", "request": { "method": "PUT", "url": "{{baseUrl}}/api/category/{{categoryId}}" } },
        { "name": "Admin - Delete Category", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/category/{{categoryId}}" } }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderItems\": [],\n  \"shippingAddress\": {\n    \"address\": \"123 Main Street\",\n    \"city\": \"Colombo\",\n    \"postalCode\": \"10000\",\n    \"country\": \"Sri Lanka\"\n  },\n  \"paymentMethod\": \"PayPal\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/orders"
          }
        },
        { "name": "Get My Orders", "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/mine" } },
        { "name": "Get Order By ID - IDOR Test", "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/{{orderId}}" } },
        { "name": "Pay Order", "request": { "method": "PUT", "url": "{{baseUrl}}/api/orders/{{orderId}}/pay" } },
        { "name": "Admin - List All Orders", "request": { "method": "GET", "url": "{{baseUrl}}/api/orders" } },
        { "name": "Admin - Mark Order Delivered", "request": { "method": "PUT", "url": "{{baseUrl}}/api/orders/{{orderId}}/deliver" } },
        { "name": "Admin - Total Orders", "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/total-orders" } },
        { "name": "Admin - Total Sales", "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/total-sales" } },
        { "name": "Admin - Sales By Date", "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/total-sales-by-date" } }
      ]
    },
    {
      "name": "Configuration",
      "item": [
        { "name": "PayPal Configuration", "request": { "method": "GET", "url": "{{baseUrl}}/api/config/paypal" } }
      ]
    },
    {
      "name": "Security Tests",
      "item": [
        {
          "name": "NoSQL Injection Login Test",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": {\"$ne\": null},\n  \"password\": {\"$ne\": null}\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users/auth"
          }
        },
        {
          "name": "Unauthenticated Admin Metrics Test",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/total-sales" }
        },
        {
          "name": "Unauthenticated Order Access Test",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/{{orderId}}" }
        }
      ]
    }
  ]
}
