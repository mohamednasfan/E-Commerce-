{
  "info": {
    "_postman_id": "7d3ecf2f-7f46-4f03-a559-0d1a0a7f3b1e",
    "name": "MERN E-Commerce Store API",
    "description": "Core API requests for the MERN E-Commerce Store.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "productId",
      "value": "replace-product-id"
    },
    {
      "key": "orderId",
      "value": "replace-order-id"
    }
  ],
  "item": [
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "Login User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": "{{baseUrl}}/api/users/auth"
      }
    },
    {
      "name": "List Products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "Get Product",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "Get My Profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users/profile"
      }
    },
    {
      "name": "Get My Orders",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/mine"
      }
    },
    {
      "name": "Get Order By ID - IDOR Test",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/{{orderId}}"
      }
    },
    {
      "name": "Public Sales Metrics Test",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/total-sales"
      }
    }
  ]
}
